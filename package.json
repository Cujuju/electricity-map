{
  "name": "electricity-map",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Electricity intelligence desktop app with SolidJS, Electron, and Node.js.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs --dev",
    "dev:shortcut": "node scripts/dev-shortcut.mjs",
    "build": "vite build",
    "build:pages": "vite build && node scripts/build-pages.mjs",
    "start": "node scripts/desktop.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "data:refresh": "node --env-file-if-exists=.env scripts/refresh-all.mjs",
    "data:refresh:quarterly": "node --env-file-if-exists=.env scripts/fetch-data.mjs",
    "data:refresh:monthly": "node --env-file-if-exists=.env scripts/fetch-monthly.mjs",
    "data:refresh:utilities": "node scripts/fetch-utilities.mjs",
    "dev:web": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start:web": "node --env-file-if-exists=.env server/index.mjs",
    "pages:dev": "wrangler pages dev dist-pages --port 8788",
    "pages:deploy": "wrangler pages deploy dist-pages --project-name electricity-map",
    "ci:local": "node scripts/release-pages.mjs --ci",
    "release": "node scripts/release-pages.mjs",
    "release:weekly": "node scripts/local-deploy/runner.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "icons": "pwsh -NoProfile -File scripts/make-icons.ps1"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-solid": "1.66.0",
    "solid-js": "1.9.18",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.6",
    "@types/topojson-client": "3.1.5",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "fflate": "0.8.3",
    "read-excel-file": "9.3.14",
    "rollup-plugin-license": "3.7.1",
    "typescript": "7.0.2",
    "us-atlas": "3.0.1",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15",
    "wrangler": "4.158.0"
  },
  "productName": "Electricity Map",
  "main": "desktop/main.mjs",
  "author": "Cuju Ju"
}
